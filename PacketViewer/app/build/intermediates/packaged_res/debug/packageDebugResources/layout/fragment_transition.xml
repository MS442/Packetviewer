<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IPv6 Transition Mechanisms"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:text="Real packets are built, translated or tunnelled and checksum-verified. Latency and throughput come from the numbers below plus per-packet costs measured on this phone." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="Mechanism" />

        <Spinner
            android:id="@+id/spTransitionMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- Input fields are added here in code (TransitionFragment.buildForm) -->
        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <CheckBox
            android:id="@+id/cbV6Blackholed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/colorAccent"
            android:text="IPv6 path is black-holed (dual-stack race)" />

        <Button
            android:id="@+id/btnRunTransition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Run"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@color/white" />

        <ProgressBar
            android:id="@+id/pbTransition"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#0A0F14">

            <TextView
                android:id="@+id/tvTransitionOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textColor="#B2FF59"
                android:textSize="11sp"
                android:textIsSelectable="true"
                android:text="Press Run. The report shows each packet before and after, the checksums, and the measured latency and throughput." />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
