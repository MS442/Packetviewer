<?xml version="1.0" encoding="utf-8"?>
<!--
  RFC 791 IPv4 header grid.
  Each row's TextViews use layout_weight to represent relative bit-widths
  of a 32-bit row, e.g. Version(4) + IHL(4) + ToS(8) + TotalLength(16) = 32.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Row 1: Version | IHL | ToS | Total Length -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cellVersion"
            style="@style/GridCellStyle"
            android:layout_weight="4"
            android:text="Version\n(4b)" />

        <TextView
            android:id="@+id/cellIHL"
            style="@style/GridCellStyle"
            android:layout_weight="4"
            android:text="IHL\n(4b)" />

        <TextView
            android:id="@+id/cellTOS"
            style="@style/GridCellStyle"
            android:layout_weight="8"
            android:text="Type of Service\n(8b)" />

        <TextView
            android:id="@+id/cellTotalLength"
            style="@style/GridCellStyle"
            android:layout_weight="16"
            android:text="Total Length\n(16b)" />
    </LinearLayout>

    <!-- Row 2: Identification | Flags | Fragment Offset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cellIdentification"
            style="@style/GridCellStyle"
            android:layout_weight="16"
            android:text="Identification\n(16b)" />

        <TextView
            android:id="@+id/cellFlags"
            style="@style/GridCellStyle"
            android:layout_weight="3"
            android:text="Flags\n(3b)" />

        <TextView
            android:id="@+id/cellFragOffset"
            style="@style/GridCellStyle"
            android:layout_weight="13"
            android:text="Fragment Offset\n(13b)" />
    </LinearLayout>

    <!-- Row 3: TTL | Protocol | Header Checksum -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cellTTL"
            style="@style/GridCellStyle"
            android:layout_weight="8"
            android:text="TTL\n(8b)" />

        <TextView
            android:id="@+id/cellProtocol"
            style="@style/GridCellStyle"
            android:layout_weight="8"
            android:text="Protocol\n(8b)" />

        <TextView
            android:id="@+id/cellChecksum"
            style="@style/GridCellStyle"
            android:layout_weight="16"
            android:text="Header Checksum\n(16b)" />
    </LinearLayout>

    <!-- Row 4: Source Address (32b full width) -->
    <TextView
        android:id="@+id/cellSrcIP"
        style="@style/GridCellStyle"
        android:layout_width="match_parent"
        android:text="Source IP Address (32 bits)" />

    <!-- Row 5: Destination Address (32b full width) -->
    <TextView
        android:id="@+id/cellDstIP"
        style="@style/GridCellStyle"
        android:layout_width="match_parent"
        android:text="Destination IP Address (32 bits)" />

</LinearLayout>
