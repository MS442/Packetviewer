<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cellSelected" />
            <stroke android:width="2dp" android:color="@color/colorPrimary" />
            <corners android:radius="4dp" />
            <padding android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cellDefault" />
            <stroke android:width="1dp" android:color="@color/cellBorder" />
            <corners android:radius="4dp" />
            <padding android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
